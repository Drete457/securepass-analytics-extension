{
  "name": "securepass-analytics-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "package": "npm run build && cd dist && tar -a -c -f ../extension/extension-package.zip *",
    "package:webstore": "npm run package && echo Extension package ready for Chrome Web Store: extension/extension-package.zip"
  },
  "dependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/qrcode": "^1.5.5",
    "crypto-js": "^4.2.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@eslint/js": "^9.25.0",
    "@types/chrome": "^0.0.319",
    "@types/dom-speech-recognition": "^0.0.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
